# Copy to .env (gitignored — never commit real values) and fill in.
# The dossier's own security rule: API keys live in the Hub's
# environment only, never in firmware, never committed to Git.

# From https://aistudio.google.com/apikey (or your GCP project).
GEMINI_API_KEY=

# No default is hardcoded anywhere in this codebase on purpose — Gemini
# Live's exact model naming changes over time. Get the current Live API
# model ID from Google's docs (https://ai.google.dev/gemini-api/docs/live)
# at integration time rather than trusting an old value here.
GEMINI_LIVE_MODEL=

# Optional — see bit_hub/backend/voice/wake.py. Leave unset until
# hey_bit.onnx exists and you've measured real scores; until then the
# wake word never auto-triggers and {"type": "force_listen"} is the
# manual stand-in (see docs/PROTOCOL.md).
BIT_WAKE_THRESHOLD=
